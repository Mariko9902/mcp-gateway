# MCP gateway inbound auth token (required if you want to prevent unauthorized access)
MCP_GATEWAY_TOKEN=a-very-long-random-token

# Optional: if you prefer to keep runtime flags here, you can export and reference them in your start script
# MCP_GATEWAY_LISTEN=127.0.0.1:15410
# MCP_GATEWAY_ROOT=~/Coding/mcp
# MCP_GATEWAY_ROUTES=./routes.yaml
# MCP_GATEWAY_STATE=./mcp-gateway.state.json
# MCP_GATEWAY_IDLE=3600s

# Default backend timeout used when route timeout is not set or invalid.
# Applies to:
# - HTTP backend create session / rpc / delete requests
# - direct (non-session) local command timeout waiting for first response
MCP_GATEWAY_DEFAULT_TIMEOUT=3600s
